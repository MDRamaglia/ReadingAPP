# Servicio de cuentas y comunidad: 'local' (prueba en el dispositivo, por defecto)
# o 'remote' (servidor real, pendiente de conexión; ver docs/backend.md).
VITE_BACKEND=local

# Solo con VITE_BACKEND=remote: datos PÚBLICOS del proveedor (nunca claves secretas).
# VITE_BACKEND_URL=
# VITE_BACKEND_PUBLIC_KEY=
