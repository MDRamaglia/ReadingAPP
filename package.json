{
  "name": "knowmadic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lector de documentos Word y PDF en español con modo libro y modo de concentración de línea única. Todo se procesa en el dispositivo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "python3 scripts/fixtures/make_all.py"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "idb": "^8.0.3",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.29.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
